generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  name                   String
  email                  String                  @unique
  passwordHash           String
  role                   UserRole                @default(USER)
  communitySuspendedAt   DateTime?
  communitySuspensionReason String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  chatMessages           ChatMessage[]
  children               ChildProfile[]
  communityBookmarks     CommunityBookmark[]
  conversationsA CommunityConversation[] @relation("ConversationA")
  conversationsB CommunityConversation[] @relation("ConversationB")
  directMessages CommunityDirectMessage[]
  communityProfile       CommunityProfile?
  communityFollowsSent   CommunityMemberFollow[] @relation("CommunityFollowFrom")
  communityFollowsReceived CommunityMemberFollow[] @relation("CommunityFollowTo")
  communityTopicFollows CommunityTopicFollow[]
  communityBlocksSent    CommunityBlock[] @relation("CommunityBlockFrom")
  communityBlocksReceived CommunityBlock[] @relation("CommunityBlockTo")
  communityReports      CommunityReport[] @relation("CommunityReportReporter")
  communityReportsReviewed CommunityReport[] @relation("CommunityReportReviewer")
  communityModerationActions CommunityModerationAction[]
  communityNotifications CommunityNotification[]
  communityGroupsCreated CommunityGroup[]
  communityGroupMemberships CommunityGroupMember[]
  communityMedia         CommunityMedia[]
  communityComments      CommunityComment[]
  communityLikes         CommunityLike[]
  communityPosts         CommunityPost[]
  consents               ConsentRecord[]
  exerciseSessions       ExerciseSession[]
  questionnaireResponses QuestionnaireResponse[]
  uploads                VideoUpload[]
  doctorProfile          DoctorProfile?
  doctorLinksGranted     DoctorChildLink[]
  doctorInvitationsCreated DoctorInvitation[] @relation("DoctorInvitationCreator")
  doctorProfilesVerified DoctorProfile[] @relation("DoctorProfileVerifier")
  doctorAccessEvents     DoctorAccessEvent[]
}

model ChildProfile {
  id                     String                  @id @default(uuid())
  userId                 String
  fullName               String
  dateOfBirth            DateTime
  gender                 Gender                  @default(UNSPECIFIED)
  note                   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  consents               ConsentRecord[]
  exerciseSessions       ExerciseSession[]
  questionnaireResponses QuestionnaireResponse[]
  uploads                VideoUpload[]
  personalization        ChildPersonalization?
  doctorLinks            DoctorChildLink[]

  @@index([userId])
}

/// What the parent told the app about the child so the experience can adapt
/// (Giai đoạn 6). One optional row per child; never used for screening.
model ChildPersonalization {
  childId       String       @id
  nickname      String?
  interests     String[]
  communication String?
  sensory       String[]
  calming       String?
  goals         String?
  focusAreas    String[]
  guideSpeed    String       @default("AUTO")
  practiceMode  String       @default("AUTO")
  liveCoach     Boolean?
  weeklyGoal    Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  child         ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
}

/// A doctor / specialist account (Giai đoạn 7). `isMock` marks the sample
/// doctors used to try the sharing flow.
model DoctorProfile {
  id           String            @id @default(uuid())
  userId       String            @unique
  displayName  String
  title        String
  specialty    String
  workplace    String
  city         String
  bio          String
  languages    String[]
  isMock       Boolean           @default(false)
  acceptingNew Boolean           @default(true)
  verificationStatus DoctorVerificationStatus @default(PENDING)
  verifiedAt   DateTime?
  verifiedById String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy   User?             @relation("DoctorProfileVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  links        DoctorChildLink[]

  @@index([city])
}

/// A parent's grant: this doctor may read the listed parts of this child's
/// record until `revokedAt`. `statement` is the exact text the parent agreed to.
model DoctorChildLink {
  id           String        @id @default(uuid())
  doctorId     String
  childId      String
  grantedById  String
  scopes       String[]
  version      String
  statement    Json
  message      String?
  grantedAt    DateTime      @default(now())
  expiresAt    DateTime?
  revokedAt    DateTime?
  lastViewedAt DateTime?
  viewCount    Int           @default(0)
  child        ChildProfile  @relation(fields: [childId], references: [id], onDelete: Cascade)
  doctor       DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  grantedBy    User          @relation(fields: [grantedById], references: [id], onDelete: Cascade)
  accessEvents DoctorAccessEvent[]

  @@index([doctorId, revokedAt])
  @@index([childId])
  @@index([grantedById])
  @@index([expiresAt])
}

model DoctorManagementEvent {
  id         String   @id @default(uuid())
  doctorId   String
  adminId    String
  adminName  String
  action     String
  previous   String
  next       String
  occurredAt DateTime @default(now())

  @@index([doctorId, occurredAt])
}

model DoctorInvitation {
  id           String   @id @default(uuid())
  email        String
  tokenHash    String   @unique
  displayName  String
  title        String
  specialty    String
  workplace    String
  city         String
  bio          String
  languages    String[]
  createdById  String
  expiresAt    DateTime
  usedAt       DateTime?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  createdBy    User     @relation("DoctorInvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([email, expiresAt])
}

model DoctorAccessEvent {
  id          String   @id @default(uuid())
  linkId      String
  actorUserId String?
  type        DoctorAccessEventType
  occurredAt  DateTime @default(now())
  metadata    Json?
  link        DoctorChildLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([linkId, occurredAt])
  @@index([type, occurredAt])
}

model VideoUpload {
  id               String           @id @default(uuid())
  userId           String
  childId          String
  originalFilename String
  storedFilename   String
  filePath         String
  mimeType         String
  fileSize         Int
  durationSeconds  Int?
  status           ScreeningStatus  @default(UPLOADED)
  errorMessage     String?
  createdAt        DateTime         @default(now())
  consentId        String?
  durationMs       Int?
  videoDeletedAt   DateTime?
  videoHeight      Int?
  videoWidth       Int?
  job              ScreeningJob?
  result           ScreeningResult?
  child            ChildProfile     @relation(fields: [childId], references: [id], onDelete: Cascade)
  consent          ConsentRecord?   @relation(fields: [consentId], references: [id])
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([childId])
  @@index([status])
  @@index([createdAt])
}

model ScreeningResult {
  id                      String      @id @default(uuid())
  videoId                 String      @unique
  riskLevel               RiskLevel
  confidenceScore         Float
  eyeContactScore         Float?
  motorPatternScore       Float?
  responseBehaviorScore   Float?
  repetitiveBehaviorScore Float?
  recommendation          String
  rawAiResponse           Json
  createdAt               DateTime    @default(now())
  asdProbability          Float?
  calibrated              Boolean?
  decisionThreshold       Float?
  gaitFeatures            Json?
  highRiskThreshold       Float?
  modelVersion            String?
  video                   VideoUpload @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([riskLevel])
  @@index([createdAt])
}

model ConsentRecord {
  id               String            @id @default(uuid())
  userId           String
  childId          String
  version          String
  scopes           String[]
  statement        Json?
  grantedAt        DateTime          @default(now())
  revokedAt        DateTime?
  child            ChildProfile      @relation(fields: [childId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseSessions ExerciseSession[]
  uploads          VideoUpload[]

  @@index([childId])
  @@index([userId])
}

model ScreeningJob {
  id          String      @id @default(uuid())
  videoId     String      @unique
  status      JobStatus   @default(QUEUED)
  attempts    Int         @default(0)
  maxAttempts Int         @default(3)
  runAfter    DateTime    @default(now())
  lockedBy    String?
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  video       VideoUpload @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
}

model Exercise {
  id                String             @id @default(uuid())
  slug              String             @unique
  title             String
  description       String
  childPrompt       String
  difficulty        Int                @default(1)
  bodyFocus         String[]
  source            String             @default("ADMIN")
  status            ExerciseStatus     @default(DRAFT)
  sortOrder         Int                @default(0)
  currentTemplateId String?            @unique
  createdById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  currentTemplate   ExerciseTemplate?  @relation("CurrentTemplate", fields: [currentTemplateId], references: [id])
  sessions          ExerciseSession[]
  templates         ExerciseTemplate[] @relation("ExerciseTemplates")

  @@index([status, sortOrder])
}

model ExerciseTemplate {
  id                       String            @id @default(uuid())
  exerciseId               String
  version                  Int
  source                   String
  sourceSubjectId          String?
  sourceAttestation        Json?
  sourceMlSubjectDeletedAt DateTime?
  sourceFps                Float
  fpsSource                String
  mirrorPolicy             MirrorPolicy
  algorithmVersion         String
  templateHash             String
  activeStartSec           Float
  activeEndSec             Float
  durationSec              Float
  lateralized              Boolean
  activeParts              String[]
  guideTrack               Json
  features                 Json
  quality                  Json
  selfTest                 Json?
  createdById              String?
  createdAt                DateTime          @default(now())
  currentOf                Exercise?         @relation("CurrentTemplate")
  sessions                 ExerciseSession[]
  exercise                 Exercise          @relation("ExerciseTemplates", fields: [exerciseId], references: [id], onDelete: Cascade)
  scores                   SessionScore[]

  @@unique([exerciseId, version])
  @@index([templateHash])
}

model ExerciseSession {
  id                 String                @id @default(uuid())
  userId             String
  childId            String
  exerciseId         String
  templateId         String
  consentId          String?
  status             ExerciseSessionStatus @default(QUEUED)
  recordedVia        String
  practiceMode       String
  playbackRate       Float                 @default(1)
  guideOffsetMs      Int?
  storedFilename     String
  filePath           String
  mimeType           String
  fileSize           Int
  durationMs         Int?
  videoWidth         Int?
  videoHeight        Int?
  videoDeletedAt     DateTime?
  mlSubjectId        String?               @unique
  mlSubjectDeletedAt DateTime?
  attempts           Int                   @default(0)
  maxAttempts        Int                   @default(2)
  runAfter           DateTime              @default(now())
  lockedBy           String?
  lockedAt           DateTime?
  lastError          String?
  errorMessage       String?
  completedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  child              ChildProfile          @relation(fields: [childId], references: [id], onDelete: Cascade)
  consent            ConsentRecord?        @relation(fields: [consentId], references: [id])
  exercise           Exercise              @relation(fields: [exerciseId], references: [id])
  template           ExerciseTemplate      @relation(fields: [templateId], references: [id])
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores             SessionScore[]

  @@index([childId, exerciseId, createdAt])
  @@index([status, runAfter])
  @@index([userId])
}

model SessionScore {
  id               String           @id @default(uuid())
  sessionId        String
  templateId       String
  algorithmVersion String
  templateHash     String
  status           String
  overall          Int?
  stars            Int?
  band             String?
  mode             String?
  reasonCodes      String[]
  detail           Json
  createdAt        DateTime         @default(now())
  session          ExerciseSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  template         ExerciseTemplate @relation(fields: [templateId], references: [id])

  @@unique([sessionId, algorithmVersion])
  @@index([templateId])
}

model QuestionnaireResponse {
  id                  String       @id @default(uuid())
  userId              String
  childId             String
  instrument          String
  structureVersion    String
  scoringVersion      String
  mode                String
  contentVersion      String?
  respondent          String
  childAgeMonths      Int
  answers             Json
  totalScore          Int
  band                String
  failedItems         Int[]
  followUpStatus      String
  followUpSource      String?
  followUpFailedItems Int[]
  followUpFailCount   Int?
  followUpAnswers     Json?
  followUpCompletedAt DateTime?
  outcome             String
  rescreenAfter       DateTime?
  consentVersion      String
  consentStatement    Json
  consentedAt         DateTime
  completedAt         DateTime     @default(now())
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  child               ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([childId, completedAt])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  role      ChatRole
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Article {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String
  category  String
  createdAt DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

model CommunityPost {
  id            String              @id @default(uuid())
  userId        String
  category      PostCategory        @default(STORY)
  title         String
  content       String
  isAnonymous   Boolean             @default(false)
  isPinned      Boolean             @default(false)
  hiddenAt      DateTime?
  likesCount    Int                 @default(0)
  commentsCount Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  groupId       String?
  bookmarks     CommunityBookmark[]
  comments      CommunityComment[]
  likes         CommunityLike[]
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  group         CommunityGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  media         CommunityMedia[]
  reports       CommunityReport[]
  notifications CommunityNotification[]

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model CommunityComment {
  id          String             @id @default(uuid())
  postId      String
  userId      String
  parentId    String?
  content     String
  isAnonymous Boolean            @default(false)
  hiddenAt    DateTime?
  createdAt   DateTime           @default(now())
  parent      CommunityComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     CommunityComment[] @relation("CommentReplies")
  post        CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports     CommunityReport[]
  notifications CommunityNotification[]

  @@index([postId])
  @@index([userId])
}

model CommunityLike {
  id        String        @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model CommunityBookmark {
  id        String        @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model CommunityProfile {
  userId      String   @id
  displayName String   @unique
  bio         String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunityMemberFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User @relation("CommunityFollowFrom", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("CommunityFollowTo", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
}

model CommunityTopicFollow {
  userId    String
  category  PostCategory
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
}

model CommunityBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User @relation("CommunityBlockFrom", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User @relation("CommunityBlockTo", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model CommunityGroup {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  category    PostCategory
  createdById String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  members     CommunityGroupMember[]
  posts       CommunityPost[]

  @@index([category, isActive])
}

model CommunityGroupMember {
  groupId  String
  userId   String
  joinedAt DateTime @default(now())
  group    CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId, joinedAt])
}

model CommunityMedia {
  id          String   @id @default(uuid())
  uploaderId  String
  postId      String?
  storageName String   @unique
  mimeType    String
  byteSize    Int
  width       Int
  height      Int
  createdAt   DateTime @default(now())
  uploader    User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  post        CommunityPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([uploaderId, createdAt])
}

model CommunityReport {
  id           String   @id @default(uuid())
  reporterId   String
  postId       String?
  commentId    String?
  directMessageId String?
  directMessage CommunityDirectMessage? @relation(fields: [directMessageId], references: [id], onDelete: SetNull)
  reason       String
  details      String   @default("")
  status       CommunityReportStatus @default(OPEN)
  reviewedById String?
  reviewedAt   DateTime?
  resolution   String?
  contentSnapshot String   @default("")
  authorSnapshot  String   @default("")
  createdAt    DateTime @default(now())
  reporter     User @relation("CommunityReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy   User? @relation("CommunityReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  post         CommunityPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment      CommunityComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  actions      CommunityModerationAction[]

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

model CommunityNotification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  actorId   String?
  postId    String?
  commentId String?
  groupId   String?
  conversationId String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model CommunityConversation {
  id String @id @default(uuid())
  memberAId String
  memberBId String
  inviterId String
  status String @default("PENDING")
  sourcePostId String?
  readSeqA Int @default(0)
  readSeqB Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberA User @relation("ConversationA", fields: [memberAId], references: [id], onDelete: Cascade)
  memberB User @relation("ConversationB", fields: [memberBId], references: [id], onDelete: Cascade)
  messages CommunityDirectMessage[]
  @@unique([memberAId, memberBId])
  @@index([memberAId, updatedAt])
  @@index([memberBId, updatedAt])
}

model CommunityDirectMessage {
  id String @id @default(uuid())
  seq Int @unique @default(autoincrement())
  conversationId String
  senderId String
  clientRequestId String
  content String
  hiddenAt DateTime?
  createdAt DateTime @default(now())
  conversation CommunityConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reports CommunityReport[]
  @@unique([senderId, clientRequestId])
  @@index([conversationId, seq])
  @@index([senderId, createdAt])
}

model CommunityModerationAction {
  id         String   @id @default(uuid())
  reportId   String?
  adminId    String
  action     String
  targetType String
  targetId   String
  reason     String
  createdAt  DateTime @default(now())
  report     CommunityReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  admin      User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId, createdAt])
  @@index([adminId, createdAt])
}

enum UserRole {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum ScreeningStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ChatRole {
  USER
  ASSISTANT
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ExerciseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MirrorPolicy {
  EITHER
  ANATOMICAL_ONLY
  MIRROR_ONLY
}

enum ExerciseSessionStatus {
  QUEUED
  PROCESSING
  SCORED
  INSUFFICIENT
  FAILED
}

enum PostCategory {
  STORY
  PARENTING
  LIFESTYLE
  EDUCATION
  QA
}

enum DoctorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DoctorAccessEventType {
  GRANTED
  REVOKED
  EXPIRED
  VIEWED
}

enum CommunityReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}
