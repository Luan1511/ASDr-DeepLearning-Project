generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  name                   String
  email                  String                  @unique
  passwordHash           String
  role                   UserRole                @default(USER)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  chatMessages           ChatMessage[]
  children               ChildProfile[]
  communityBookmarks     CommunityBookmark[]
  communityComments      CommunityComment[]
  communityLikes         CommunityLike[]
  communityPosts         CommunityPost[]
  consents               ConsentRecord[]
  exerciseSessions       ExerciseSession[]
  questionnaireResponses QuestionnaireResponse[]
  uploads                VideoUpload[]
}

model ChildProfile {
  id                     String                  @id @default(uuid())
  userId                 String
  fullName               String
  dateOfBirth            DateTime
  gender                 Gender                  @default(UNSPECIFIED)
  note                   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  consents               ConsentRecord[]
  exerciseSessions       ExerciseSession[]
  questionnaireResponses QuestionnaireResponse[]
  uploads                VideoUpload[]

  @@index([userId])
}

model VideoUpload {
  id               String           @id @default(uuid())
  userId           String
  childId          String
  originalFilename String
  storedFilename   String
  filePath         String
  mimeType         String
  fileSize         Int
  durationSeconds  Int?
  status           ScreeningStatus  @default(UPLOADED)
  errorMessage     String?
  createdAt        DateTime         @default(now())
  consentId        String?
  durationMs       Int?
  videoDeletedAt   DateTime?
  videoHeight      Int?
  videoWidth       Int?
  job              ScreeningJob?
  result           ScreeningResult?
  child            ChildProfile     @relation(fields: [childId], references: [id], onDelete: Cascade)
  consent          ConsentRecord?   @relation(fields: [consentId], references: [id])
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([childId])
  @@index([status])
  @@index([createdAt])
}

model ScreeningResult {
  id                      String      @id @default(uuid())
  videoId                 String      @unique
  riskLevel               RiskLevel
  confidenceScore         Float
  eyeContactScore         Float?
  motorPatternScore       Float?
  responseBehaviorScore   Float?
  repetitiveBehaviorScore Float?
  recommendation          String
  rawAiResponse           Json
  createdAt               DateTime    @default(now())
  asdProbability          Float?
  calibrated              Boolean?
  decisionThreshold       Float?
  gaitFeatures            Json?
  highRiskThreshold       Float?
  modelVersion            String?
  video                   VideoUpload @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([riskLevel])
  @@index([createdAt])
}

model ConsentRecord {
  id               String            @id @default(uuid())
  userId           String
  childId          String
  version          String
  scopes           String[]
  statement        Json?
  grantedAt        DateTime          @default(now())
  revokedAt        DateTime?
  child            ChildProfile      @relation(fields: [childId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseSessions ExerciseSession[]
  uploads          VideoUpload[]

  @@index([childId])
  @@index([userId])
}

model ScreeningJob {
  id          String      @id @default(uuid())
  videoId     String      @unique
  status      JobStatus   @default(QUEUED)
  attempts    Int         @default(0)
  maxAttempts Int         @default(3)
  runAfter    DateTime    @default(now())
  lockedBy    String?
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  video       VideoUpload @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
}

model Exercise {
  id                String             @id @default(uuid())
  slug              String             @unique
  title             String
  description       String
  childPrompt       String
  difficulty        Int                @default(1)
  bodyFocus         String[]
  source            String             @default("ADMIN")
  status            ExerciseStatus     @default(DRAFT)
  sortOrder         Int                @default(0)
  currentTemplateId String?            @unique
  createdById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  currentTemplate   ExerciseTemplate?  @relation("CurrentTemplate", fields: [currentTemplateId], references: [id])
  sessions          ExerciseSession[]
  templates         ExerciseTemplate[] @relation("ExerciseTemplates")

  @@index([status, sortOrder])
}

model ExerciseTemplate {
  id                       String            @id @default(uuid())
  exerciseId               String
  version                  Int
  source                   String
  sourceSubjectId          String?
  sourceAttestation        Json?
  sourceMlSubjectDeletedAt DateTime?
  sourceFps                Float
  fpsSource                String
  mirrorPolicy             MirrorPolicy
  algorithmVersion         String
  templateHash             String
  activeStartSec           Float
  activeEndSec             Float
  durationSec              Float
  lateralized              Boolean
  activeParts              String[]
  guideTrack               Json
  features                 Json
  quality                  Json
  selfTest                 Json?
  createdById              String?
  createdAt                DateTime          @default(now())
  currentOf                Exercise?         @relation("CurrentTemplate")
  sessions                 ExerciseSession[]
  exercise                 Exercise          @relation("ExerciseTemplates", fields: [exerciseId], references: [id], onDelete: Cascade)
  scores                   SessionScore[]

  @@unique([exerciseId, version])
  @@index([templateHash])
}

model ExerciseSession {
  id                 String                @id @default(uuid())
  userId             String
  childId            String
  exerciseId         String
  templateId         String
  consentId          String?
  status             ExerciseSessionStatus @default(QUEUED)
  recordedVia        String
  practiceMode       String
  playbackRate       Float                 @default(1)
  guideOffsetMs      Int?
  storedFilename     String
  filePath           String
  mimeType           String
  fileSize           Int
  durationMs         Int?
  videoWidth         Int?
  videoHeight        Int?
  videoDeletedAt     DateTime?
  mlSubjectId        String?               @unique
  mlSubjectDeletedAt DateTime?
  attempts           Int                   @default(0)
  maxAttempts        Int                   @default(2)
  runAfter           DateTime              @default(now())
  lockedBy           String?
  lockedAt           DateTime?
  lastError          String?
  errorMessage       String?
  completedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  child              ChildProfile          @relation(fields: [childId], references: [id], onDelete: Cascade)
  consent            ConsentRecord?        @relation(fields: [consentId], references: [id])
  exercise           Exercise              @relation(fields: [exerciseId], references: [id])
  template           ExerciseTemplate      @relation(fields: [templateId], references: [id])
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores             SessionScore[]

  @@index([childId, exerciseId, createdAt])
  @@index([status, runAfter])
  @@index([userId])
}

model SessionScore {
  id               String           @id @default(uuid())
  sessionId        String
  templateId       String
  algorithmVersion String
  templateHash     String
  status           String
  overall          Int?
  stars            Int?
  band             String?
  mode             String?
  reasonCodes      String[]
  detail           Json
  createdAt        DateTime         @default(now())
  session          ExerciseSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  template         ExerciseTemplate @relation(fields: [templateId], references: [id])

  @@unique([sessionId, algorithmVersion])
  @@index([templateId])
}

model QuestionnaireResponse {
  id                  String       @id @default(uuid())
  userId              String
  childId             String
  instrument          String
  structureVersion    String
  scoringVersion      String
  mode                String
  contentVersion      String?
  respondent          String
  childAgeMonths      Int
  answers             Json
  totalScore          Int
  band                String
  failedItems         Int[]
  followUpStatus      String
  followUpSource      String?
  followUpFailedItems Int[]
  followUpFailCount   Int?
  followUpAnswers     Json?
  followUpCompletedAt DateTime?
  outcome             String
  rescreenAfter       DateTime?
  consentVersion      String
  consentStatement    Json
  consentedAt         DateTime
  completedAt         DateTime     @default(now())
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  child               ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([childId, completedAt])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  role      ChatRole
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Article {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String
  category  String
  createdAt DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

model CommunityPost {
  id            String              @id @default(uuid())
  userId        String
  category      PostCategory        @default(STORY)
  title         String
  content       String
  isAnonymous   Boolean             @default(false)
  isPinned      Boolean             @default(false)
  likesCount    Int                 @default(0)
  commentsCount Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  bookmarks     CommunityBookmark[]
  comments      CommunityComment[]
  likes         CommunityLike[]
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model CommunityComment {
  id          String             @id @default(uuid())
  postId      String
  userId      String
  parentId    String?
  content     String
  isAnonymous Boolean            @default(false)
  createdAt   DateTime           @default(now())
  parent      CommunityComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     CommunityComment[] @relation("CommentReplies")
  post        CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model CommunityLike {
  id        String        @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model CommunityBookmark {
  id        String        @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

enum UserRole {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum ScreeningStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ChatRole {
  USER
  ASSISTANT
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ExerciseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MirrorPolicy {
  EITHER
  ANATOMICAL_ONLY
  MIRROR_ONLY
}

enum ExerciseSessionStatus {
  QUEUED
  PROCESSING
  SCORED
  INSUFFICIENT
  FAILED
}

enum PostCategory {
  STORY
  PARENTING
  LIFESTYLE
  EDUCATION
  QA
}
