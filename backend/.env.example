# Server
NODE_ENV=development
PORT=4000

# PostgreSQL (Prisma)
# Example: postgresql://postgres:postgres@localhost:5432/asdr?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asdr?schema=public

# Auth
# Must be >= 16 chars
JWT_SECRET=change-me-super-secret-please
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Upload
MAX_UPLOAD_MB=200

# Prediction API
# Can be the API root (backend will call /pipeline/asd) or a full endpoint URL.
EXTRACT_API_URL=http://localhost:8000/pipeline/asd
BYPASS_EXTRACT_API=false

# Optional chat/LLM API
CHAT_API_BASE_URL=http://localhost:8000
