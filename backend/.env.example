# Server
NODE_ENV=development
PORT=4000

# PostgreSQL (Prisma)
# Example: postgresql://postgres:postgres@localhost:5432/asdr?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asdr?schema=public

# Auth
# Must be >= 16 chars
JWT_SECRET=change-me-super-secret-please
JWT_EXPIRES_IN=7d

# CORS (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Upload limits (MB)
MAX_UPLOAD_MB=1024
SKELETON_MAX_UPLOAD_MB=200

# OpenPose & ST-GCN ML server (only the origin is used)
OPENPOSE_SERVER_URL=http://127.0.0.1:8000
EXTRACT_API_URL=http://127.0.0.1:8000/pipeline/asd
# Must equal ML_API_KEY on the ML server (sent as X-API-Key). Empty = no header.
OPENPOSE_API_KEY=
EXTRACT_API_TIMEOUT_MS=3600000
# true = random mock results (no ML server needed; UI testing only)
BYPASS_EXTRACT_API=false

# Screening queue
# OpenPose calls allowed in flight from this backend (one GTX 1650 -> 1)
ML_MAX_CONCURRENCY=1
SCREENING_MAX_ATTEMPTS=3
SCREENING_POLL_INTERVAL_MS=3000

# Decision thresholds. Leave empty to use the ML server's calibration.json
# (or its defaults: threshold 0.5, temperature 1.0).
SCREENING_THRESHOLD=
SCREENING_TEMPERATURE=
# Used only when the ML server sends no high_risk_threshold.
SCREENING_HIGH_RISK_THRESHOLD=0.7

# Privacy: keep raw uploads after a successful analysis (default false = delete)
RETAIN_UPLOADED_VIDEOS=false

# Optional chat/LLM API (not used yet)
CHAT_API_BASE_URL=http://localhost:8000

# Giai đoạn 4: motor exercises + imitation scoring (master_prompt.md §6.7)
# off | admin_only | on. Keep admin_only until the scoring passed the adult
# calibration gate (C1); parents only see exercises with "on".
EXERCISE_MODE=admin_only
EXERCISE_WORKER_ENABLED=true
EXERCISE_MAX_UPLOAD_MB=100
EXERCISE_MAX_DURATION_SEC=60
EXERCISE_MAX_PENDING_PER_CHILD=3
EXERCISE_MAX_ATTEMPTS=2
EXERCISE_EXTRACT_TIMEOUT_MS=600000
EXERCISE_POLL_INTERVAL_MS=3000
# Only after `npm run exercises:probe-ml` showed the ML 1.0 server decodes .webm sent as .mkv
EXERCISE_WEBM_AS_MKV=false

# Parent questionnaire M-CHAT-R/F (master_prompt.md §6.8, docs/MCHAT_PERMISSION.md).
# off | entry | inapp. entry = answers typed by item number from the official form (no item text);
# inapp = items + Follow-Up in the app, needs the authors' permission and a licensed content file
# (npm run questionnaires:validate-content must report "ready"; until then inapp behaves like entry).
MCHAT_MODE=off
# Licensed Vietnamese text for inapp (gitignored), relative to backend/ unless absolute.
MCHAT_CONTENT_PATH=content/mchat-rf.vi.json
