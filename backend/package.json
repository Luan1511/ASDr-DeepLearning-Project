{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "predev": "prisma generate",
    "dev": "nodemon --watch src --ext ts --exec tsx src/server.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "tsx --test test/gaitFeatures.test.ts test/screeningResult.test.ts test/semaphore.test.ts test/prismaErrors.test.ts test/childInput.test.ts test/screeningData.test.ts test/poseTracking.test.ts test/imitationScoring.test.ts test/imitationTemplate.test.ts test/imitationConstants.test.ts test/imitationFeedback.test.ts test/exerciseInput.test.ts test/exerciseData.test.ts test/exerciseSerializers.test.ts test/exerciseConsent.test.ts test/mchatRf.test.ts test/questionnaireAge.test.ts test/questionnaireCopy.test.ts test/mchatRfStructure.test.ts test/followUpEngine.test.ts test/mchatContent.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "prisma:deploy": "prisma migrate deploy",
    "privacy:purge-videos": "tsx scripts/purgeProcessedVideos.ts",
    "exercises:probe-ml": "tsx scripts/probeMlExercise.ts",
    "exercises:calibrate": "tsx scripts/calibrateImitation.ts",
    "privacy:purge-exercise-uploads": "tsx scripts/purgeExerciseUploads.ts",
    "test:e2e": "tsx --test --test-concurrency=1 test/e2e/exercise.e2e.ts test/e2e/questionnaire.e2e.ts test/e2e/questionnaireInApp.e2e.ts",
    "questionnaires:content-template": "tsx scripts/mchatContentTemplate.ts",
    "questionnaires:validate-content": "tsx scripts/validateMchatContent.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "archiver": "^8.0.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "prisma": "^6.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "nodemon": "^3.1.7",
    "tsx": "^4.20.2",
    "typescript": "^5.6.3"
  }
}
