# Used by docker-compose.yml. Copy to .env and fill in; never commit .env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=asdr

# >= 16 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string

# Shared secret between backend and ML server (X-API-Key). Leave empty only for local tests.
ML_API_KEY=

# Where the backend reaches the ML server:
#   GPU host / ngrok:  https://<tunnel>  or http://host.docker.internal:8000
#   compose profile ml: http://ml-api:8000
OPENPOSE_SERVER_URL=http://host.docker.internal:8000

# Host folder containing a Linux OpenPose build (only for `--profile ml`).
OPENPOSE_HOST_DIR=/workspace/openpose

# Bạn Bin (voice pilot): set http://buddy-voice:8020 with the buddy-voice Compose profile.
BUDDY_VOICE_URL=

# Questionnaire: use entry for official-form entry in a demo. Default is off.
MCHAT_MODE=off

# Sharing a child's record with a doctor: off | demo (sample doctors, labelled as such) | on (real doctors only).
DOCTOR_MODE=demo
# Video screening via OpenPose: off | admin_only (default; parents use the Kinect station) | on
VIDEO_SCREENING=admin_only

# Show the webcam recording download on the review screen for admins.
# Motor exercises: off | admin_only | on (parents can practise)
EXERCISE_MODE=on
EXERCISE_DEBUG_RECORDING_DOWNLOAD=true

# true = random mock results (UI testing without the ML server)
BYPASS_EXTRACT_API=false

# Internal RAG API, called only by backend
CHAT_API_BASE_URL=http://asdr-rag-rag-1:8050
CHAT_API_KEY=
