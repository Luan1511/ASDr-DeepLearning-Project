# Used by docker-compose.yml. Copy to .env and fill in; never commit .env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=asdr

# >= 16 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string

# Shared secret between backend and ML server (X-API-Key). Leave empty only for local tests.
ML_API_KEY=

# Where the backend reaches the ML server:
#   GPU host / ngrok:  https://<tunnel>  or http://host.docker.internal:8000
#   compose profile ml: http://ml-api:8000
OPENPOSE_SERVER_URL=http://host.docker.internal:8000

# Host folder containing a Linux OpenPose build (only for `--profile ml`).
OPENPOSE_HOST_DIR=/workspace/openpose

# true = random mock results (UI testing without the ML server)
BYPASS_EXTRACT_API=false
